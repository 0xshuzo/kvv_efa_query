# Resolve a JSON provider by its public API and CMake declarations, never its
# checkout directory name. Local source providers take priority over search roots.
function(_json_source_provider source output)
  set(${output} "" PARENT_SCOPE)
  if(NOT EXISTS "${source}/CMakeLists.txt" OR IS_DIRECTORY "${source}/CMakeLists.txt" OR
     NOT EXISTS "${source}/include/nlohmann/json.hpp" OR
     IS_DIRECTORY "${source}/include/nlohmann/json.hpp")
    return()
  endif()
  file(READ "${source}/CMakeLists.txt" declaration)
  string(REGEX REPLACE "#[^\n]*" "" declaration "${declaration}")
  string(TOLOWER "${declaration}" declaration)
  if(NOT declaration MATCHES
      "(project[ \t\r\n]*\\([ \t\r\n]*\"?nlohmann_json\"?[ \t\r\n)]|add_library[ \t\r\n]*\\([ \t\r\n]*\"?nlohmann_json(::nlohmann_json)?\"?[ \t\r\n)])")
    return()
  endif()
  file(READ "${source}/include/nlohmann/json.hpp" header)
  if(NOT header MATCHES "class[ \t\r\n]+basic_json")
    return()
  endif()
  if(EXISTS "${source}/include/nlohmann/detail/abi_macros.hpp" AND
     NOT IS_DIRECTORY "${source}/include/nlohmann/detail/abi_macros.hpp")
    file(READ "${source}/include/nlohmann/detail/abi_macros.hpp" header)
  endif()
  set(version)
  foreach(part MAJOR MINOR PATCH)
    if(header MATCHES "#[ \t]*define[ \t]+NLOHMANN_JSON_VERSION_${part}[ \t]+([0-9]+)")
      list(APPEND version "${CMAKE_MATCH_1}")
    endif()
  endforeach()
  list(LENGTH version components)
  string(REPLACE ";" "." version "${version}")
  if(components EQUAL 3 AND NOT version VERSION_LESS "3.11")
    get_filename_component(source "${source}" REALPATH)
    set(${output} "${source}" PARENT_SCOPE)
  endif()
endfunction()

function(_json_source_scan directory visited_name matches_name)
  get_filename_component(directory "${directory}" REALPATH)
  get_filename_component(name "${directory}" NAME)
  set(visited "${${visited_name}}")
  set(matches "${${matches_name}}")
  list(FIND visited "${directory}" index)
  if(NOT index EQUAL -1 OR name MATCHES "^\\." OR
     (EXISTS "${directory}/CMakeCache.txt" AND
      (NOT EXISTS "${directory}/CMakeLists.txt" OR IS_DIRECTORY "${directory}/CMakeLists.txt")))
    return()
  endif()
  list(APPEND visited "${directory}")
  _json_source_provider("${directory}" provider)
  if(provider)
    list(APPEND matches "${provider}")
  endif()

  # Follow source symlinks once; checkout names may contain literal glob characters.
  string(REGEX REPLACE "([][?*])" "[\\1]" glob_directory "${directory}")
  file(GLOB children LIST_DIRECTORIES TRUE "${glob_directory}/*")
  foreach(child IN LISTS children)
    get_filename_component(name "${child}" NAME)
    if(IS_DIRECTORY "${child}" AND NOT name MATCHES "^\\.")
      _json_source_scan("${child}" visited matches)
    endif()
  endforeach()
  set(${visited_name} "${visited}" PARENT_SCOPE)
  set(${matches_name} "${matches}" PARENT_SCOPE)
endfunction()

function(ensure_json_dependency local_source)
  if(TARGET nlohmann_json::nlohmann_json)
    return()
  endif()

  if(NOT DEFINED JSON_SOURCE_DIR)
    set(JSON_SOURCE_DIR "" CACHE PATH "Source directory providing nlohmann/json >= 3.11")
  endif()
  if(NOT "${JSON_SOURCE_DIR}" STREQUAL "")
    get_filename_component(source "${JSON_SOURCE_DIR}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
    _json_source_provider("${source}" provider)
    if(NOT provider)
      message(FATAL_ERROR "Invalid JSON_SOURCE_DIR: choose a nlohmann/json >= 3.11 source checkout.")
    endif()
    set(candidates "${provider}")
  else()
    find_package(nlohmann_json 3.11 CONFIG QUIET)
    if(TARGET nlohmann_json::nlohmann_json)
      # Promote in the directory where find_package created the imported target,
      # so parent and sibling consumers see the same package on CMake 3.16 too.
      get_target_property(provider nlohmann_json::nlohmann_json ALIASED_TARGET)
      if(NOT provider)
        set(provider nlohmann_json::nlohmann_json)
      endif()
      get_target_property(imported "${provider}" IMPORTED)
      if(imported)
        set_property(TARGET "${provider}" PROPERTY IMPORTED_GLOBAL TRUE)
      endif()
      return()
    endif()

    if(NOT DEFINED SOURCE_DEPENDENCY_ROOTS)
      set(SOURCE_DEPENDENCY_ROOTS "" CACHE STRING "Semicolon-separated source dependency search roots")
    endif()
    set(roots ${SOURCE_DEPENDENCY_ROOTS} $ENV{SOURCE_DEPENDENCY_ROOTS})
    set(canonical_roots)
    foreach(root IN LISTS roots)
      if(root STREQUAL "")
        continue()
      endif()
      get_filename_component(root "${root}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
      if(NOT IS_DIRECTORY "${root}")
        message(FATAL_ERROR "Invalid SOURCE_DEPENDENCY_ROOTS: '${root}' is not a directory.")
      endif()
      get_filename_component(root "${root}" REALPATH)
      list(APPEND canonical_roots "${root}")
    endforeach()
    list(REMOVE_DUPLICATES canonical_roots)
    set(visited)
    set(candidates)
    _json_source_scan("${local_source}" visited candidates)
    if(NOT candidates)
      foreach(root IN LISTS canonical_roots)
        _json_source_scan("${root}" visited candidates)
      endforeach()
    endif()
    list(REMOVE_DUPLICATES candidates)
    list(LENGTH candidates count)
    if(count GREATER 1)
      message(FATAL_ERROR "Multiple nlohmann/json source providers found: ${candidates}. "
        "Set JSON_SOURCE_DIR to the intended source checkout.")
    elseif(count EQUAL 0)
      message(FATAL_ERROR "Missing nlohmann/json >= 3.11. "
        "Set JSON_SOURCE_DIR, CMAKE_PREFIX_PATH, or initialize submodules.")
    endif()
  endif()

  list(GET candidates 0 source)
  string(SHA256 identity "${source}")
  add_subdirectory("${source}" "${CMAKE_BINARY_DIR}/_source_dependencies/json-${identity}"
    EXCLUDE_FROM_ALL)
  if(NOT TARGET nlohmann_json::nlohmann_json)
    message(FATAL_ERROR "JSON source ${source} did not define nlohmann_json::nlohmann_json.")
  endif()
endfunction()
